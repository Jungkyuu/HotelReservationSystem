<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.FeedbackController" prefWidth="400" prefHeight="260">
    <children>
        <VBox spacing="10" layoutX="20" layoutY="20" prefWidth="360">
            <Label text="🙌 We value your feedback!" style="-fx-font-size: 18px;"/>
            <Label text="Rating (1-5):"/>
            <TextField fx:id="ratingField" promptText="1-5" prefWidth="200"/>
            <Label text="Comments:"/>
            <TextArea fx:id="commentsArea" prefWidth="360" prefHeight="100"/>
            <Button text="Submit Feedback" onAction="#handleSubmit"/>
        </VBox>
    </children>
</AnchorPane>
